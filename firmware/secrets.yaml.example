# Copy to secrets.yaml (or add these keys to the secrets of your ESPHome dashboard).
# Never commit the real file.
wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"
# 32 random bytes, base64. Generate one with:  openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_BASE64_KEY"
# Password of the fallback hotspot the device opens when it cannot reach your Wi-Fi (min. 8 characters)
ap_password: "choose-a-password"
